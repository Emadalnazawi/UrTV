<?xml version="1.0" encoding="utf-8"?>
<!-- the rows of the dialogs' lists (theme attribute listChoiceBackgroundIndicator): nothing, and the focused glass -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/glass_focus" />
    <item android:state_pressed="true" android:drawable="@drawable/glass_focus" />
    <item android:drawable="@android:color/transparent" />
</selector>
