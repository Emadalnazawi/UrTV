<?xml version="1.0" encoding="utf-8"?>
<!-- a dialog's list row, dark look: white, and dark ink on the focused row's white fill -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#14161A" />
    <item android:state_selected="true" android:color="#14161A" />
    <item android:state_pressed="true" android:color="#14161A" />
    <item android:color="#FFFFFF" />
</selector>
