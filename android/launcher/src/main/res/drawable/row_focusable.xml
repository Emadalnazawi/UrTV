<?xml version="1.0" encoding="utf-8"?>
<!-- a row that shows the focus by itself (the sleep timer's rows are views of a dialog, not rows of a list that paint the selection): the gold frame when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/row_selected" />
    <item android:state_pressed="true" android:drawable="@drawable/row_selected" />
    <item android:drawable="@drawable/row_bg" />
</selector>
