[
 {
  "text": "الصبر مفتاح الفرج",
  "source": "مثل عربي"
 },
 {
  "text": "الجار قبل الدار",
  "source": "مثل عربي"
 },
 {
  "text": "الرفيق قبل الطريق",
  "source": "مثل عربي"
 },
 {
  "text": "الصديق وقت الضيق",
  "source": "مثل عربي"
 },
 {
  "text": "ما حكَّ جلدَك مثلُ ظفرِك",
  "source": "مثل عربي"
 },
 {
  "text": "من جدَّ وجد، ومن زرع حصد",
  "source": "مثل عربي"
 },
 {
  "text": "لكلِّ مقامٍ مقال",
  "source": "مثل عربي"
 },
 {
  "text": "الطيور على أشكالها تقع",
  "source": "مثل عربي"
 },
 {
  "text": "الحاجة تفتق الحيلة",
  "source": "مثل عربي"
 },
 {
  "text": "إذا عُرف السبب بطل العجب",
  "source": "مثل عربي"
 },
 {
  "text": "ربَّ أخٍ لك لم تلده أمُّك",
  "source": "مجمع الأمثال للميداني"
 },
 {
  "text": "الصيف ضيَّعتِ اللبن",
  "source": "مجمع الأمثال للميداني"
 },
 {
  "text": "على نفسها جنت براقش",
  "source": "مجمع الأمثال للميداني"
 },
 {
  "text": "أسمع جعجعةً ولا أرى طحنًا",
  "source": "مجمع الأمثال للميداني"
 },
 {
  "text": "اليد الواحدة لا تصفِّق",
  "source": "مثل عربي"
 },
 {
  "text": "في التأني السلامة وفي العجلة الندامة",
  "source": "مثل عربي"
 },
 {
  "text": "من حفر حفرةً لأخيه وقع فيها",
  "source": "مثل عربي"
 },
 {
  "text": "الحرُّ تكفيه الإشارة",
  "source": "مثل عربي"
 },
 {
  "text": "ما لا يُدرَك كلُّه لا يُترك كلُّه",
  "source": "مثل عربي"
 },
 {
  "text": "الباب الذي يأتيك منه الريح سدَّه واستَرِح",
  "source": "مثل عربي"
 },
 {
  "text": "كلُّ إناءٍ بما فيه ينضح",
  "source": "مثل عربي"
 },
 {
  "text": "رمتني بدائها وانسلَّت",
  "source": "مجمع الأمثال للميداني"
 },
 {
  "text": "أعطِ الخبزَ لخبَّازه ولو أكل نصفه",
  "source": "مثل عربي"
 },
 {
  "text": "عند الامتحان يُكرَم المرء أو يُهان",
  "source": "مثل عربي"
 },
 {
  "text": "الوقت من ذهب",
  "source": "مثل عربي"
 },
 {
  "text": "إن كان الكلام من فضة فالسكوت من ذهب",
  "source": "مثل عربي"
 },
 {
  "text": "العلم في الصغر كالنقش على الحجر",
  "source": "مثل عربي"
 },
 {
  "text": "من شبَّ على شيءٍ شاب عليه",
  "source": "مثل عربي"
 },
 {
  "text": "جزاء سنمَّار",
  "source": "مجمع الأمثال للميداني"
 },
 {
  "text": "ربَّ ضارةٍ نافعة",
  "source": "مثل عربي"
 },
 {
  "text": "الغائب حجَّته معه",
  "source": "مثل عربي"
 },
 {
  "text": "الناس معادن",
  "source": "مثل عربي"
 },
 {
  "text": "ما ضاع حقٌّ وراءه مطالب",
  "source": "مثل عربي"
 },
 {
  "text": "لا دخان بلا نار",
  "source": "مثل عربي"
 },
 {
  "text": "البعيد عن العين بعيد عن القلب",
  "source": "مثل عربي"
 },
 {
  "text": "كثرة الطباخين تحرق الطبيخ",
  "source": "مثل عربي"
 },
 {
  "text": "الطمع يُقلُّ ما جمع",
  "source": "مثل عربي"
 },
 {
  "text": "أول الغيث قطرة",
  "source": "مثل عربي"
 },
 {
  "text": "الاتحاد قوة",
  "source": "مثل عربي"
 },
 {
  "text": "القرد في عين أمه غزال",
  "source": "مثل عربي"
 },
 {
  "text": "الجود بالموجود",
  "source": "مثل عربي"
 },
 {
  "text": "لكلِّ جوادٍ كبوة",
  "source": "مجمع الأمثال للميداني"
 },
 {
  "text": "لكلِّ ساقطةٍ لاقطة",
  "source": "مثل عربي"
 },
 {
  "text": "ليس كلُّ ما يلمع ذهبًا",
  "source": "مثل عربي"
 },
 {
  "text": "الحاجة أم الاختراع",
  "source": "مثل عربي"
 },
 {
  "text": "درهم وقاية خيرٌ من قنطار علاج",
  "source": "مثل عربي"
 },
 {
  "text": "من صبر ظفر",
  "source": "مثل عربي"
 },
 {
  "text": "الإنسان بأخلاقه",
  "source": "مثل عربي"
 },
 {
  "text": "الوعد دَين",
  "source": "مثل عربي"
 },
 {
  "text": "الطبع يغلب التطبع",
  "source": "مثل عربي"
 },
 {
  "text": "الجزاء من جنس العمل",
  "source": "مثل عربي"
 },
 {
  "text": "كلُّ ممنوعٍ مرغوب",
  "source": "مثل عربي"
 },
 {
  "text": "عِش رجبًا ترَ عجبًا",
  "source": "مجمع الأمثال للميداني"
 },
 {
  "text": "ما كلُّ بيضاءَ شحمة ولا كلُّ سوداءَ تمرة",
  "source": "مجمع الأمثال للميداني"
 },
 {
  "text": "دوام الحال من المحال",
  "source": "مثل عربي"
 },
 {
  "text": "الباطل لا يدوم",
  "source": "مثل عربي"
 },
 {
  "text": "خير البرِّ عاجله",
  "source": "مجمع الأمثال للميداني"
 },
 {
  "text": "الحذر لا يمنع القدر",
  "source": "مثل عربي"
 },
 {
  "text": "التكرار يعلِّم الشطَّار",
  "source": "مثل عربي"
 },
 {
  "text": "اللبيب بالإشارة يفهم",
  "source": "مثل عربي"
 },
 {
  "text": "آخر الدواء الكيّ",
  "source": "مثل عربي"
 },
 {
  "text": "جاء يكحِّلها فأعماها",
  "source": "مجمع الأمثال للميداني"
 },
 {
  "text": "حبل الكذب قصير",
  "source": "مثل عربي"
 },
 {
  "text": "من تأنَّى نال ما تمنَّى",
  "source": "مثل عربي"
 },
 {
  "text": "لا ناقة لي فيها ولا جمل",
  "source": "مثل عربي"
 }
]
